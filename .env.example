APP_NAME="FDCP Calendar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL/MariaDB in production and local dev. Tests run on in-memory SQLite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fdcp_calendar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Reminders and notifications are queued. Run a worker:
#   php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Typed settings are read on every request; cache them (auto-refreshed on save).
SETTINGS_CACHE_ENABLED=true

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev: Mailpit (http://localhost:8025). Production: your SMTP relay.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="calendar@fdcp.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# FDCP SSO (fdcp-accounts). On the SSO server:
#   php artisan app:register-client calendar --redirect="${APP_URL}/auth/fdcp/callback"
FDCP_ACCOUNTS_URL=https://sso.fdcp.ph
FDCP_ACCOUNTS_CLIENT_ID=
FDCP_ACCOUNTS_CLIENT_SECRET=
FDCP_ACCOUNTS_REDIRECT_URI="${APP_URL}/auth/fdcp/callback"

# Google Calendar integration (see docs/google-calendar.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/settings/google-calendar/callback"
GOOGLE_CALENDAR_WEBHOOK_URL="${APP_URL}/webhooks/google-calendar"
GOOGLE_CALENDAR_API_KEY=

VITE_APP_NAME="${APP_NAME}"
